# Kopiuj do .env.local (plik jest w .gitignore). Nigdy nie commituj prawdziwych wartości.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SITE_URL=https://rankingbiurnieruchomosci.pl
NEXT_PUBLIC_CONTACT_EMAIL=
# Panel admina: jeden użytkownik. Hasz wygeneruj poleceniem: npm run hash-password -- 'haslo'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Min. 32 znaki losowe, np. openssl rand -base64 48
ADMIN_SESSION_SECRET=
