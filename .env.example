# Kopiuj do .env (plik .env jest w .gitignore). Nigdy nie commituj prawdziwych wartości.

# Baza (Neon). Connection string z konsoli Neon lub z narzędzia get_connection_string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Wyszukiwanie (wymienne adaptery). Ustaw te, których używasz.
BRAVE_API_KEY=
SERPER_API_KEY=

# Rejestry
# Biała lista VAT (MF): publiczne, bez klucza. Adres bazowy konfigurowalny, bo źródła
# wskazują możliwą zmianę domeny (wl-api.mf.gov.pl lub wykazpodatnikowvat.mf.gov.pl/api).
MF_VAT_BASE_URL=https://wl-api.mf.gov.pl
# KRS Open API: publiczne, bez klucza.
KRS_BASE_URL=https://api-krs.ms.gov.pl
# CEIDG (hurtownia danych): wymaga konta na biznes.gov.pl i tokenu JWT.
CEIDG_JWT=

# Crawler
# Domyślnie: KatalogBot/0.1 (+https://rankingbiurnieruchomosci.pl/bot). Ustaw tylko, jeśli ma być inaczej.
# CRAWLER_USER_AGENT=
CRAWLER_MIN_DELAY_SECONDS=2.0

# Katalog z paczkami dla Claude Code (kolejka plikowa)
QUEUE_DIR=./queue
# Surowe strony pobrane przez crawler (do ponownej ekstrakcji bez ponownego pobierania)
SNAPSHOTS_DIR=./snapshots
